# Force LF line endings for Java files to match spotless expectations
*.java text eol=lf

# Already handled by git autocrlf on Windows, but be explicit for scripts
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - don't touch
*.png binary
*.jpg binary
*.svg binary
*.ico binary
