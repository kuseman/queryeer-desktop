{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queryeer.dev/schema/plugin.v1.json",
  "title": "Queryeer Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "providesCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["entrypointClass"] },
        { "required": ["factoryClass"] }
      ],
      "properties": {
        "entrypointClass": {
          "type": "string",
          "minLength": 1
        },
        "factoryClass": {
          "type": "string",
          "minLength": 1
        },
        "classpath": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "include"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "minJavaVersion": {
          "type": "string"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryModule"
      ],
      "properties": {
        "entryModule": {
          "type": "string",
          "minLength": 1
        },
        "moduleFormat": {
          "type": "string",
          "enum": [
            "esm",
            "cjs"
          ]
        },
        "apiVersion": {
          "type": "string"
        }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jarsDir": {
              "type": "string"
            },
            "typescriptDir": {
              "type": "string"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "description": "Trusted shared-runtime declaration for built-in plugins. External plugins must provide backend and/or frontend entrypoints; runtime-only external packages are not loaded.",
      "additionalProperties": false,
      "required": ["shared"],
      "properties": {
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parentFirstPackagePrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!com\\.$|org\\.$).{3,}\\.$"
              },
              "uniqueItems": true
            },
            "nativeLibraries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["filePatterns", "loaderClass"],
                "properties": {
                  "os": { "type": "string", "minLength": 1 },
                  "arch": { "type": "string", "minLength": 1 },
                  "searchPaths": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "filePatterns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "not": { "pattern": "(?:\\.\\.|[/\\\\])" }
                    }
                  },
                  "required": { "type": "boolean" },
                  "loaderClass": { "type": "string", "minLength": 1 }
                }
              }
            },
            "sharedArtifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern"],
                "properties": {
                  "pattern": { "type": "string", "minLength": 1 },
                  "required": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "backend"
          ]
        },
        {
          "required": [
            "frontend"
          ]
        },
        {
          "required": [
            "runtime"
          ]
        }
      ]
    }
  ]
}
