{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queryeer.dev/schema/plugin.v1.json",
  "title": "Queryeer Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "providesCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypointClass"
      ],
      "properties": {
        "entrypointClass": {
          "type": "string",
          "minLength": 1
        },
        "classpath": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "minJavaVersion": {
          "type": "string"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryModule"
      ],
      "properties": {
        "entryModule": {
          "type": "string",
          "minLength": 1
        },
        "moduleFormat": {
          "type": "string",
          "enum": [
            "esm",
            "cjs"
          ]
        },
        "apiVersion": {
          "type": "string"
        }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jarsDir": {
              "type": "string"
            },
            "typescriptDir": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "backend"
          ]
        },
        {
          "required": [
            "frontend"
          ]
        }
      ]
    }
  ]
}
