<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.queryeer.backend</groupId>
        <artifactId>queryeer-backend</artifactId>
        <version>0.9.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>backend-lib-queryengine-sql-parser</artifactId>
    <name>Queryeer Backend SQL Parser</name>
    <description>Tree-sitter based SQL parser library for Queryeer plugins</description>

    <properties>
        <tree-sitter.version>0.26.6</tree-sitter.version>
        <tree-sitter-sql.version>gh-pages-a</tree-sitter-sql.version>
        <queryeer.plugin.id>queryengine.runtime.sql-parser</queryeer.plugin.id>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter</artifactId>
            <version>${tree-sitter.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-sql</artifactId>
            <version>${tree-sitter-sql.version}</version>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>write-queryeer-plugin-deps</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/queryeer-plugin-deps.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>${project.parent.basedir}/src/assembly/backend-plugin.xml</descriptor>
                    </descriptors>
                    <finalName>${queryeer.plugin.id}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>assemble-queryeer-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
