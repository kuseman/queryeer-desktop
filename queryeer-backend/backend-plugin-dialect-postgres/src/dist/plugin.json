{
  "schemaVersion": 1,
  "id": "queryengine.jdbc.dialect.postgres",
  "name": "PostgreSQL JDBC Dialect",
  "version": "${project.version}",
  "description": "PostgreSQL dialect runtime contribution.",
  "dependencies": ["queryengine.jdbc"],
  "providesCapabilities": ["queryengine.jdbc.dialect.postgres"],
  "requiredCapabilities": ["queryengine.jdbc.connection"],
  "backend": {
    "entrypointClass": "com.queryeer.backend.plugin.jdbc.postgres.PostgresBackendPlugin"
  },
  "runtime": {
    "shared": {
      "parentFirstPackagePrefixes": ["org.postgresql."],
      "sharedArtifacts": [
        {
          "pattern": "postgresql-*.jar",
          "required": false
        }
      ]
    }
  }
}
