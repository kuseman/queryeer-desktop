<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.queryeer.backend</groupId>
        <artifactId>queryeer-backend</artifactId>
        <version>0.11.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>backend-plugin-payloadbuilder</artifactId>
    <name>Queryeer Payloadbuilder Plugin</name>

    <properties>
        <skipPublishing>true</skipPublishing>
        <queryeer.plugin.id>queryengine.payloadbuilder</queryeer.plugin.id>
    </properties>


    <dependencies>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-lib-queryengine-payloadbuilder-foundation</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-lib-queryengine-jdbc-foundation</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-lib-queryengine-sql-parser</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>se.kuseman.payloadbuilder</groupId>
            <artifactId>payloadbuilder-core</artifactId>
        </dependency>
        <dependency>
            <groupId>se.kuseman.payloadbuilder</groupId>
            <artifactId>payloadbuilder-catalog</artifactId>
        </dependency>
        <!--
            payloadbuilder-catalog declares avro as an optional dependency. Optional deps are not pulled transitively, so we declare it explicitly
            here to ensure the plugin assembly (which uses useTransitiveDependencies=true, scope=runtime) bundles avro-1.11.4.jar into lib/. The plugin
            never references avro classes directly, so this is a packaging-only requirement. Marked optional so the avro jar is not propagated to
            downstream consumers of this plugin.
        -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>1.11.4</version>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>write-queryeer-plugin-deps</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/queryeer-plugin-deps.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>${project.parent.basedir}/src/assembly/backend-plugin.xml</descriptor>
                    </descriptors>
                    <finalName>${queryeer.plugin.id}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>assemble-queryeer-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
