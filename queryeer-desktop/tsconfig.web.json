{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/core/**/*.ts",
    "src/plugins/**/*.ts",
    "src/plugins/**/*.tsx",
    "src/plugins/**/*.json",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts"
  ]
}
