{
  "name": "queryeer-desktop",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run -w @queryeer/app build",
    "dev": "npm run -w @queryeer/app dev",
    "typecheck": "npm run --workspaces typecheck",
    "lint": "npm run --workspaces lint",
    "test": "npm run -w @queryeer/api build && npm run -w @queryeer/app test",
    "test:integration": "npm run -w @queryeer/api build && npm run -w @queryeer/app test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.2",
    "@rollup/rollup-darwin-x64": "^4.60.2",
    "@rollup/rollup-darwin-arm64": "^4.60.2",
    "@rollup/rollup-win32-x64-msvc": "^4.60.2"
  }
}
