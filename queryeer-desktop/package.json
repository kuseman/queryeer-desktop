{
  "name": "queryeer-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Queryeer Desktop",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:protocol-fixtures": "vitest run --project main src/main/backend/protocol-fixtures.test.ts",
    "test:integration": "vitest run --project integration",
    "dev:plugin:stage": "node scripts/dev-plugin-stage.mjs",
    "dev:classpath:probe:stage": "node scripts/dev-classpath-probe-stage.mjs",
    "dev:classpath:probe:smoke": "node scripts/dev-classpath-probe-smoke.mjs",
    "dev:plugin:watch": "node scripts/dev-plugin-watch.mjs",
    "dev:with-plugins": "node scripts/dev-with-plugins.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xterm/addon-fit": "^0.12.0-beta.204",
    "@xterm/addon-search": "^0.17.0-beta.204",
    "@xterm/addon-web-links": "^0.13.0-beta.204",
    "@xterm/xterm": "^6.1.0-beta.204",
    "@xyflow/react": "^12.10.2",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "chokidar": "^4.0.3",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "dompurify": "3.4.3"
  },
  "build": {
    "appId": "com.queryeer.electron",
    "productName": "Queryeer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
